# Figma API Configuration
FIGMA_TOKEN=your_figma_token_here

# Get your Figma token from:
# https://www.figma.com/developers/api#access-tokens 

# Supabase Configuration (Optional - for persistent request history)
# If not provided, the server will use in-memory storage
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# Get your Supabase credentials from:
# https://supabase.com/dashboard/project/your-project/settings/api 